{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@agile-team/mach-table": [
        "packages/core/src/index.ts"
      ],
      "@agile-team/mach-table/adapter": [
        "packages/core/src/adapter.ts"
      ],
      "@agile-team/mach-table/worker": [
        "packages/core/src/worker.ts"
      ],
      "@agile-team/mach-table-vue": [
        "packages/vue/src/index.ts"
      ],
      "@agile-team/mach-table-react": [
        "packages/react/src/index.ts"
      ],
      "@agile-team/mach-table-xlsx": [
        "packages/xlsx/src/index.ts"
      ],
      "@agile-team/mach-table/workbench": [
        "packages/core/src/workbench.ts"
      ],
      "@agile-team/mach-table/preferences": [
        "packages/core/src/preferences.ts"
      ],
      "@agile-team/mach-table/ordering": [
        "packages/core/src/ordering.ts"
      ],
      "@agile-team/mach-table/server-side": [
        "packages/core/src/server-side.ts"
      ],
      "@agile-team/mach-table/analysis": [
        "packages/core/src/analysis.ts"
      ],
      "@agile-team/mach-table/multi-range": [
        "packages/core/src/multiRange.ts"
      ],
      "@agile-team/mach-table/import": [
        "packages/core/src/import.ts"
      ]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true
  }
}
