{
  "name": "@agile-team/mach-table-react",
  "version": "0.35.1",
  "description": "Official React 18+ adapter for the MachTable enterprise data grid",
  "keywords": [
    "react",
    "data-grid",
    "table",
    "typescript",
    "virtualization"
  ],
  "author": "ChenyCHENYU (Agile Team)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/ChenyCHENYU/MachTable#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/MachTable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/MachTable.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./workflows": {
      "import": {
        "types": "./dist/workflows.d.ts",
        "default": "./dist/workflows.js"
      },
      "require": {
        "types": "./dist/workflows.d.cts",
        "default": "./dist/workflows.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/mach-table.css.d.ts",
      "default": "./dist/mach-table.css"
    },
    "./styles/mach-table.css": {
      "types": "./dist/mach-table.css.d.ts",
      "default": "./dist/mach-table.css"
    },
    "./workbench": {
      "import": {
        "types": "./dist/workbench.d.ts",
        "default": "./dist/workbench.js"
      },
      "require": {
        "types": "./dist/workbench.d.cts",
        "default": "./dist/workbench.cjs"
      }
    },
    "./preferences": {
      "import": {
        "types": "./dist/preferences.d.ts",
        "default": "./dist/preferences.js"
      },
      "require": {
        "types": "./dist/preferences.d.cts",
        "default": "./dist/preferences.cjs"
      }
    },
    "./ordering": {
      "import": {
        "types": "./dist/ordering.d.ts",
        "default": "./dist/ordering.js"
      },
      "require": {
        "types": "./dist/ordering.d.cts",
        "default": "./dist/ordering.cjs"
      }
    },
    "./server-side": {
      "import": {
        "types": "./dist/server-side.d.ts",
        "default": "./dist/server-side.js"
      },
      "require": {
        "types": "./dist/server-side.d.cts",
        "default": "./dist/server-side.cjs"
      }
    },
    "./analysis": {
      "import": {
        "types": "./dist/analysis.d.ts",
        "default": "./dist/analysis.js"
      },
      "require": {
        "types": "./dist/analysis.d.cts",
        "default": "./dist/analysis.cjs"
      }
    },
    "./multi-range": {
      "import": {
        "types": "./dist/multi-range.d.ts",
        "default": "./dist/multi-range.js"
      },
      "require": {
        "types": "./dist/multi-range.d.cts",
        "default": "./dist/multi-range.cjs"
      }
    },
    "./styles/workbench.css": {
      "types": "./dist/workbench.css.d.ts",
      "default": "./dist/workbench.css"
    },
    "./styles/server-side.css": {
      "types": "./dist/server-side.css.d.ts",
      "default": "./dist/server-side.css"
    },
    "./import": {
      "import": {
        "types": "./dist/import.d.ts",
        "default": "./dist/import.js"
      },
      "require": {
        "types": "./dist/import.d.cts",
        "default": "./dist/import.cjs"
      }
    },
    "./business": {
      "import": {
        "types": "./dist/business.d.ts",
        "default": "./dist/business.js"
      },
      "require": {
        "types": "./dist/business.d.cts",
        "default": "./dist/business.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-adapter-style.mjs react",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "node ../../scripts/check-publish-agent.mjs"
  },
  "dependencies": {
    "@agile-team/mach-table": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.3.1"
  }
}
