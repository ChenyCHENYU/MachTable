{
  "name": "@agile-team/mach-table-vue",
  "version": "0.4.0",
  "description": "Official Vue 3 adapter for the MachTable enterprise data grid",
  "keywords": [
    "vue",
    "vue3",
    "data-grid",
    "table",
    "typescript",
    "virtualization"
  ],
  "author": "Agile Team",
  "license": "MIT",
  "homepage": "https://github.com/ChenyCHENYU/MachTable#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/MachTable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/MachTable.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@agile-team/mach-table": "workspace:*",
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "@agile-team/mach-table": "workspace:*",
    "vue": "^3.5.13"
  }
}
