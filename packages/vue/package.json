{
  "name": "@agile-team/mach-table-vue",
  "version": "0.18.1",
  "description": "Official Vue 3 adapter for the MachTable enterprise data grid",
  "keywords": [
    "vue",
    "vue3",
    "data-grid",
    "table",
    "typescript",
    "virtualization"
  ],
  "author": "ChenyCHENYU (Agile Team)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/ChenyCHENYU/MachTable#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/MachTable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/MachTable.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/async.d.ts",
        "default": "./dist/async.js"
      },
      "require": {
        "types": "./dist/async.d.cts",
        "default": "./dist/async.cjs"
      }
    },
    "./workflows": {
      "import": {
        "types": "./dist/workflows.d.ts",
        "default": "./dist/workflows.js"
      },
      "require": {
        "types": "./dist/workflows.d.cts",
        "default": "./dist/workflows.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./editors": {
      "import": {
        "types": "./dist/editors.d.ts",
        "default": "./dist/editors.js"
      },
      "require": {
        "types": "./dist/editors.d.cts",
        "default": "./dist/editors.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/mach-table.css.d.ts",
      "default": "./dist/mach-table.css"
    },
    "./styles/mach-table.css": {
      "types": "./dist/mach-table.css.d.ts",
      "default": "./dist/mach-table.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-adapter-style.mjs vue",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agile-team/mach-table": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  }
}
